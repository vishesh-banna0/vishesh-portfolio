# Copy to `.env` (gitignored) and fill in. Never commit real secrets.

# ── Admin login ── (single admin; there is no public registration)
# Generate the hash — never store the plaintext password:
#   npm run hash-password -- "your-strong-password"
# NOTE: bcrypt hashes contain `$`. In this local .env FILE, escape each `$` as `\$`
# (the hash-password script prints the ready-to-paste, escaped line for you).
# In a hosting env UI (e.g. Vercel), paste the RAW hash with no escaping.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="\$2b\$12\$replace_with_generated_bcrypt_hash"

# Signs the session cookie. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="replace_with_a_long_random_string"

# ── Database (Postgres, e.g. Neon) ──
# DATABASE_URL: the POOLED connection (used at runtime). On Neon the host has "-pooler".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: the DIRECT (non-pooled) connection — used only for migrations.
# On Neon, the same string without "-pooler" in the host. Optional; falls back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Media storage (Vercel Blob) ──
# Required in production so admin uploads (résumé PDF, images) persist — Vercel's
# filesystem is read-only. Create a Blob store in the Vercel dashboard
# (Storage → Create → Blob); Vercel injects this token into the deployment.
# For local dev you can leave it unset (uploads fall back to the ./uploads folder),
# or paste the token here to test against the real Blob store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"

# ── Site ──
# Your production URL — used for canonical links, sitemap.xml, robots.txt, and OG images.
SITE_URL="https://your-domain.com"
